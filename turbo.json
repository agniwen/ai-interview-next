{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "i18n:compile"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", ".dev.vars*"],
      "outputs": ["dist/**", ".wrangler/deploy/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["i18n:compile"]
    },
    "dev:remote": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["i18n:compile"],
      "passThroughEnv": ["CLOUDFLARE_*", "*_PROXY", "*_proxy"]
    },
    "generate-routes": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate-routes", "i18n:compile"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_*"]
    },
    "test": {
      "dependsOn": ["^build", "i18n:compile"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["i18n:compile"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "i18n:compile"],
      "outputs": ["coverage/**"]
    },
    "i18n:compile": {
      "outputs": ["src/paraglide/**"]
    }
  }
}
