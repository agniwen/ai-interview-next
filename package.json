{
  "name": "@ai-interview/workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "generate-routes": "turbo run generate-routes",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "deploy": "bun run deploy:api && bun run deploy:web",
    "deploy:api": "turbo run deploy --filter=@ai-interview/api",
    "deploy:web": "turbo run deploy --filter=@ai-interview/web",
    "typecheck": "turbo run typecheck",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "hooks": "lefthook install",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage"
  },
  "devDependencies": {
    "@tanstack/intent": "0.5.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "turbo": "2.11.10",
    "ultracite": "8.1.0"
  },
  "packageManager": "bun@1.4.2",
  "intent": {
    "skills": [
      "@tanstack/devtools",
      "@tanstack/devtools-event-client",
      "@tanstack/devtools-vite",
      "@tanstack/match-sorter-utils",
      "@tanstack/react-router",
      "@tanstack/react-start",
      "@tanstack/react-table",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/table-core",
      "@tanstack/virtual-file-routes"
    ]
  }
}
