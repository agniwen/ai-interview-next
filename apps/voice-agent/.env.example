LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_KEY=
OPENAI_REPORT_MODEL=gpt-5.4-mini
QWEN_KEY=
QWEN_REALTIME_MODEL=qwen-audio-3.1-realtime-plus
QWEN_REALTIME_VOICE=longanlingxin
# 按密钥所属地域选择实时服务地址；默认使用中国内地服务。
# Match the endpoint to the key's region; defaults to mainland China.
QWEN_REALTIME_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# 本地联调时设为个人专属名称，客户端需使用相同名称调度。
# Use a unique name for local development and dispatch to that name from the client.
# LIVEKIT_AGENT_NAME=sainoa-voice-agent-yourname
