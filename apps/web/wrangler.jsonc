{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sainoa-web",
  "account_id": "b8f52910e25273ecc2fc719d582dece7",
  "routes": [{ "pattern": "sanioa.akumanoko.com", "custom_domain": true }],
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "sainoa-auth",
      "database_id": "f8dc4135-b75c-46a9-9e32-91acbedaadde",
      "migrations_dir": "migrations",
    },
  ],
}
