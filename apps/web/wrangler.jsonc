{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sainoa-web",
  "account_id": "b8f52910e25273ecc2fc719d582dece7",
  "routes": [{ "pattern": "sanioa.akumanoko.com", "custom_domain": true }],
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/sign-in", "/sign-in/", "/_localized/*"],
  },
  "services": [{ "binding": "API", "service": "sainoa-api" }],
}
