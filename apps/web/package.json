{
  "name": "@ai-interview/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/registry vite dev --port 3000",
