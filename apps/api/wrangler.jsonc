{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sainoa-api",
  "account_id": "b8f52910e25273ecc2fc719d582dece7",
  "routes": [
    {
      "pattern": "sainoa-api.akumanoko.com",
      "custom_domain": true,
    },
  ],
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AGENT_CHAT_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "AGENT_CHAT_MODEL": "deepseek-v4.1-flash",
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENT_SESSIONS", "class_name": "AgentSessionObject" },
      { "name": "REDIS", "class_name": "RedisObject" },
    ],
  },
  "migrations": [
    { "tag": "agent-v1", "new_sqlite_classes": ["AgentSessionObject", "RedisObject"] },
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "sainoa-auth",
      "database_id": "f8dc4135-b75c-46a9-9e32-91acbedaadde",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "RESUME_FILES", "bucket_name": "sainoa-resumes" }],
  "queues": {
    "producers": [
      { "binding": "RESUME_EXTRACT_QUEUE", "queue": "sainoa-resume-extract" },
      { "binding": "RESUME_STRUCTURE_QUEUE", "queue": "sainoa-resume-structure" },
      { "binding": "RESUME_EVALUATE_QUEUE", "queue": "sainoa-resume-evaluate" },
    ],
    "consumers": [
      {
        "queue": "sainoa-resume-extract",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 6,
      },
      {
        "queue": "sainoa-resume-structure",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 6,
      },
      {
        "queue": "sainoa-resume-evaluate",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 6,
      },
    ],
  },
  "workflows": [
    {
      "binding": "RESUME_WORKFLOW",
      "name": "sainoa-resume-processing",
      "class_name": "ResumeWorkflow",
    },
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
