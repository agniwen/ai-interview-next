{
  "name": "@ai-interview/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./types": {
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "dev": "CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/registry wrangler dev --config wrangler.jsonc --port 8787 --local",
    "dev:remote": "CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/registry wrangler dev --config wrangler.jsonc --port 8787 --persist-to .wrangler/state-remote",
    "build": "WRANGLER_NO_SKILLS_UPDATE_PROMPTS=true wrangler deploy --config wrangler.jsonc --dry-run --outdir dist",
    "deploy": "WRANGLER_NO_SKILLS_UPDATE_PROMPTS=true wrangler deploy --config wrangler.jsonc --env-file .env.production --secrets-file .env.production",
    "typecheck": "tsrs --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cf:types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc --env-interface ApiEnv --include-runtime=false",
    "db:migrate": "wrangler d1 migrations apply AUTH_DB --config wrangler.jsonc --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --config wrangler.jsonc --env-file .env.production --remote"
  },
  "dependencies": {
    "@ai-interview/agent": "workspace:*",
    "@ai-interview/db": "workspace:*",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@embedpdf/pdfium": "2.15.1",
    "@hono/standard-validator": "0.4.1",
    "ai": "7.0.163",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "files-sdk": "3.1.2",
    "hono": "catalog:",
    "jpeg-js": "0.4.4",
    "livekit-server-sdk": "2.19.2",
    "pngjs": "7.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-interview/typescript-config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/emscripten": "1.41.5",
    "@types/node": "catalog:",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
